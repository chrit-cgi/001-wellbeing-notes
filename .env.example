# Auth provider — 'local' for development, 'clerk' for production
AUTH_PROVIDER=local
VITE_AUTH_PROVIDER=local

# Required when AUTH_PROVIDER=local — change to a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Clerk — only needed when AUTH_PROVIDER=clerk
# Get these from https://dashboard.clerk.com
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# CLERK_SECRET_KEY=sk_test_replace_me

# Server port (default: 3000)
PORT=3000

# SQLite database file path
# Production / Docker: /app/data/db.sqlite (volume mount)
# Development:        ./data/db.sqlite
DATABASE_PATH=./data/db.sqlite
