{
  "name": "beingc",
  "version": "0.1.0",
  "description": "Daily wellbeing notes — mobile-first web app",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"node --env-file=.env --watch server/index.js\"",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "start": "node server/index.js",
    "lint": "eslint src/js server scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@clerk/clerk-js": "^5.0.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.21.0",
    "express-session": "^1.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "supertest": "^7.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
